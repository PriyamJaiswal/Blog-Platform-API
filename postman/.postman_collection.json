{
  "info": {
    "name": "Blog Platform API",
    "description": "REST API for a blog platform with JWT auth, posts/comments/likes, dual pagination (offset + cursor), and Redis caching (cache-aside pattern). See the repo README for architecture, performance benchmarks, and setup instructions.\n\nGitHub: https://github.com/PriyamJaiswal\n\nHow to use this collection:\n1. Set the `baseUrl` variable (defaults to localhost, change to your deployed URL).\n2. Run **Auth > Register** or **Auth > Login** — the token is auto-saved to the `token` collection variable via the test script, so every other request picks it up automatically.\n3. Explore Posts / Comments / Likes.\n4. The **Benchmarking** folder has the exact requests used to measure before/after Redis performance (see README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    },
    {
      "key": "commentId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user and returns a JWT token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "}",
                  "pm.test('Status is 200', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in an existing user and returns a JWT token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "}",
                  "pm.test('Status is 200', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Post\",\n  \"content\": \"This is the content of my first blog post.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"]
            },
            "description": "Creates a new post. Requires auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('postId', json.id);",
                  "    }",
                  "}",
                  "pm.test('Status is 201', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Posts (Offset Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Offset-based pagination. Cached under 'postFeed' (Redis, 30s TTL)."
          }
        },
        {
          "name": "Get Feed (Cursor Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/feed?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "feed"],
              "query": [
                { "key": "after", "value": "", "disabled": true, "description": "ID of the last post from the previous page" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Cursor-based pagination — pass 'after' with the last post ID from the previous response to get the next page. Cached (Redis, 30s TTL, manual cache-aside)."
          }
        },
        {
          "name": "Get Post by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            },
            "description": "Fetches a single post. Cached under 'postDetail' (Redis, 10min TTL, @Cacheable)."
          }
        },
        {
          "name": "Get Total Post Count",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/count",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "count"]
            }
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Updated Post Title\",\n  \"content\": \"Updated content.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            },
            "description": "Updates a post. Owner-only. Evicts the postDetail and feed caches for this post."
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            },
            "description": "Deletes a post. Owner-only. Evicts related caches."
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Great post!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}", "comments"]
            },
            "description": "Adds a comment to a post. Requires auth. Evicts the post's cache."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('commentId', json.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Comments for Post",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}", "comments"]
            }
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/comments/{{commentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}", "comments", "{{commentId}}"]
            },
            "description": "Deletes a comment. Owner-only."
          }
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "Toggle Like",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}/likes/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}", "likes", "toggle"]
            },
            "description": "Toggles a like on/off for the current user. Requires auth. Call twice in a row to see like -> unlike. Evicts the post's cache so likeCount stays fresh."
          }
        }
      ]
    },
    {
      "name": "Benchmarking",
      "description": "Requests used for the before/after performance benchmarks in the README. Run each via Collection Runner (30 iterations) to reproduce the numbers.",
      "item": [
        {
          "name": "Posts Benchmark",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Request successful', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "console.log(pm.info.requestName + ' | Response time: ' + pm.response.responseTime + ' ms');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Feed Benchmark",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/feed?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "feed"],
              "query": [
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Request successful', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "console.log(pm.info.requestName + ' | Response time: ' + pm.response.responseTime + ' ms');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Post Detail Benchmark",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "{{postId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Request successful', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "console.log(pm.info.requestName + ' | Response time: ' + pm.response.responseTime + ' ms');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}